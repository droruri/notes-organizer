{
  "packageId": "app.notes.organizer",
  "host": "notes-web.pages.dev",
  "name": "הפתקים שלי",
  "launcherName": "הפתקים שלי",
  "display": "standalone",
  "themeColor": "#0b5c78",
  "navigationColor": "#0b5c78",
  "backgroundColor": "#ffffff",
  "enableNotifications": false,
  "startUrl": "/",
  "iconUrl": "https://notes-web.pages.dev/icon-512.png",
