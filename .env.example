# Every environment variable the app reads. The values below are the local-stack defaults and
# work as-is with `pnpm dev`; copy to `.env` only to override. Never commit `.env`.

# ── API (apps/api) ────────────────────────────────────────────────────────────
# Postgres connection string. Local Supabase stack → `pnpm db:start` prints it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# The web app's origin — the only origin allowed to call the API (CORS).
WEB_ORIGIN=http://localhost:5173
# Port the API listens on.
PORT=3000

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# VITE_* values are bundled into the browser: never put a secret in one.
VITE_API_URL=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Supabase project URL (API verifies tokens against its JWKS). Local stack default below.
SUPABASE_URL=http://127.0.0.1:54321
# Comma-separated emails allowed to use the app (case-insensitive). Local default = seed user.
ALLOWED_EMAILS=dev@notes.local
# Web: Supabase URL and anon (public) key for sign-in. Local-stack defaults.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# ── AI (apps/api) ────────────────────────────────────────────────────────────
# Anthropic key for classification and chat. Required unless AI_FAKE is set.
ANTHROPIC_API_KEY=
# Model for classifying notes and for chat.
LLM_CLASSIFY_MODEL=claude-haiku-5-5
LLM_CHAT_MODEL=claude-sonnet-5-5
# 1 = scripted fake instead of Claude (keyless dev, tests, E2E). Set to empty in .env with a real key.
AI_FAKE=1

# Groq key for voice-note transcription (Whisper). Required unless AI_FAKE is set.
GROQ_API_KEY=

# Optional: Jina Reader (https://jina.ai/reader) reads links that block our server, so Claude can
# classify them. Without it, such links stay "not read". Empty = off.
JINA_API_KEY=

# ── Hosted setup ─────────────────────────────────────────────────────────────
# Used only by `pnpm setup:hosted` / `pnpm deploy:hosted`; leave empty for local dev. Real values go
# in .env, never here. Each deploy part is skipped with a warning when its keys are empty.
# Supabase: project ref, database password, and an access token (Account → Access Tokens).
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
# Google OAuth client, switched on as the Supabase Google provider by the deploy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Render (API host).
RENDER_API_KEY=
# Cloudflare Pages (web host).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# cron-job.org keep-alive jobs.
CRONJOB_API_KEY=
# Optional: stand-ins for a skipped Render / Pages part.
HOSTED_API_URL=
HOSTED_WEB_URL=
# Android (scripts/build-android.sh): signing keystore and its SHA-256 fingerprint.
ANDROID_KEYSTORE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEYSTORE_SHA256=
