{
  "name": "notes-organizer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "supabase start && pnpm -r --parallel --filter './apps/*' dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "lint": "vp lint && vp fmt --check",
    "format": "vp fmt",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm typecheck && pnpm -r build",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3",
    "vite-plus": "catalog:"
  }
}
